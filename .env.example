# ==============================================================================
# coinmaker-quant — Configurazione completa
# Copia questo file in .env e compila i valori
# ==============================================================================


# ==============================================================================
# SEZIONE 1 — DERIBIT API
# ==============================================================================
# Credenziali API da https://www.deribit.com/account/api (o test.deribit.com)
DERIBIT_API_KEY=your_api_key_here
DERIBIT_API_SECRET=your_api_secret_here
DERIBIT_ENV=test                       # test | live


# ==============================================================================
# SEZIONE 2 — RISK MANAGEMENT GLOBALE
# Parametri condivisi da tutte le strategie tramite RiskManager
# ==============================================================================
INITIAL_EQUITY=10000                   # Equity iniziale del conto (USD)
BASE_RISK_PCT=0.01                     # Rischio base per trade: 1% dell'equity
MAX_DAILY_LOSS_PCT=0.03                # Kill switch: stop dopo -3% giornaliero
MAX_OPEN_TRADES=3                      # Max posizioni aperte contemporaneamente
MAX_PORTFOLIO_RISK=0.03                # Max esposizione totale nozionale: 3%

# FailureHandler — emergenza se API non risponde
HEALTH_CHECK_INTERVAL_SEC=5            # Ping Deribit ogni 5 secondi
MAX_API_DOWN_SEC=30                    # Emergency close dopo 30s di API irraggiungibile


# ==============================================================================
# SEZIONE 3 — LOGGING E MONITORING
# ==============================================================================
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
MONITORING_INTERVAL_MINUTES=15         # Scansione nuovi segnali ogni N minuti

# Telegram alerts (lasciare vuoti per disabilitare)
TELEGRAM_BOT_TOKEN=                    # Token da @BotFather
TELEGRAM_CHAT_ID=                      # Chat ID dove ricevere i messaggi


# ==============================================================================
# SEZIONE 4 — ABILITAZIONE STRATEGIE
# true = strategia attiva | false = ignorata completamente
#
# Validazione quantitativa 2026-06-11 su 4 anni di dati 1m BTCUSDT
# (giu 2022 - giu 2026: bear + bull + bear), costi 0.20% roundtrip,
# nessun lookahead. Dataset: data/research/btc_1m_4y/
# Report: data/research/multicycle_report.txt
# ==============================================================================

# --- ATTIVE: validate con edge positivo attraverso il ciclo ---
TB_ENABLED=true                        # Trend Breakdown (PF 1.40, +41 bps/trade)
FS_ENABLED=true                        # Funding Squeeze (PF 2.65, +74 bps/trade)
MC_ENABLED=true                        # Macro Core (+315%/4y, maxDD 24.7%)

# Multi-symbol (validazione C3, stessi parametri di BTC su ETH 4y):
#   TB long 7d-high : OK su BTC e ETH (ETH +183bps PF 2.32, 3 anni su 3 positivi)
#   TB short 48h-low: SOLO BTC (ETH PF 0.87 — edge BTC-specifico)
#   FS              : OK su BTC e ETH (ETH +64bps PF 1.82)
#   MC              : SOLO BTC (ETH = buy&hold con maxDD 58% — bocciata)
# Con piu' simboli su MC il budget di esposizione viene diviso tra i simboli
# (BTC/ETH correlano ~0.8: trattati come ~1 posizione ai fini del rischio)
TB_SYMBOLS=BTCUSDT,ETHUSDT
TB_SHORT_SYMBOLS=BTCUSDT
FS_SYMBOLS=BTCUSDT,ETHUSDT
MC_SYMBOLS=BTCUSDT

# --- FALLIMENTARI: edge lordo zero (perdita = costi), NON riattivare ---
# senza un edge nuovo validato (pipeline: microevolutive/PLAN_BULL_EVOLUTION.md)
VB_ENABLED=false                       # Volume Breakout      (PF 0.42-0.74)
MR_ENABLED=false                       # Mean Reversion       (PF 0.28-0.53)
LIQ_ENABLED=false                      # Liquidation Squeeze  (PF 0.06-0.30)
IS_ENABLED=false                       # Imbalance Scalp      (PF 0.18-0.50)

# --- LEGACY: mai validate quantitativamente ---
STRATEGY_IRON_CONDOR_ENABLED=false     # Iron Condor su opzioni
STRATEGY_SMART_MONEY_ENABLED=false     # Smart Money Concept
WM_ENABLED=false                       # W/M Formation pattern
BRINGS_ENABLED=false                   # NY Brings session


# ==============================================================================
# SEZIONE 5 — STRATEGIA ATTIVA: TREND BREAKDOWN (bidirezionale, macro-gated)
#
# Il gate macro (daily close vs SMA200 giornaliera) decide il lato operativo:
#   macro BEAR -> SHORT su rottura del minimo 48h:  +22 bps/trade, PF 1.26
#   macro BULL -> LONG su rottura del massimo 7gg:  +68 bps/trade, PF 1.53
#                 (senza TP, hold 7gg: i vincitori vanno lasciati correre)
# Senza il gate macro ogni lato perde ~24 bps/trade nella fase avversa.
# Quando il mercato torna bull il lato long si attiva DA SOLO.
# Backtest 4y codice reale: 207 trade, +41 bps/trade, PF 1.40.
# NON modificare i parametri senza rivalidare (scripts/backtest_new_strategies.py)
# ==============================================================================
TB_SYMBOL=BTCUSDT                      # Simbolo Binance (sorgente dati)
TB_INSTRUMENT=BTC-PERPETUAL            # Strumento Deribit (esecuzione)
TB_LOOKBACK_H=48                       # Donchian low per gli short (barre 1h)
TB_LOOKBACK_LONG_H=168                 # Donchian high per i long (168h = 7 giorni)
TB_SMA_H=48                            # Filtro trend orario (SMA 48h)
TB_ATR_PERIOD=14                       # Periodo ATR su barre 1h
TB_SL_ATR_MULT=2.0                     # Stop Loss = 2 x ATR(1h)
TB_RR_RATIO=2.0                        # Take Profit short = 2R
TB_RR_LONG=0                           # 0 = nessun TP sui long (let winners run)
TB_MAX_HOLD_HOURS=24                   # Time exit short: 24h
TB_MAX_HOLD_LONG_HOURS=168             # Time exit long: 7 giorni
TB_FLOW_CONFIRM=0.50                   # Conferma flow: buy_ratio < 0.50 (short) / > 0.50 (long)
TB_ENABLE_LONG=true                    # Lato long abilitato (macro-gated)
TB_MACRO_SMA_DAYS=200                  # Gate macro: SMA 200 giorni


# ==============================================================================
# SEZIONE 6 — STRATEGIA ATTIVA: FUNDING SQUEEZE (capitolazione deep-bear)
#
# Short contrarian quando i long pagano funding AL CAP mentre il macro
# downtrend accelera: il crowding massimo in un mercato che scende alimenta
# le liquidazioni. Ingresso solo entro 60 min dal funding settlement
# (00/08/16 UTC) — il timing su cui l'edge e' stato validato.
# Backtest 4y: 15 trade, +74 bps/trade, PF 2.65, WR 60%.
# Bassa frequenza BY DESIGN: scatta solo nelle capitolazioni vere.
# ==============================================================================
FS_SYMBOL=BTCUSDT
FS_INSTRUMENT=BTC-PERPETUAL
FS_FUNDING_THRESHOLD=0.0001            # 0.01%/8h = cap exchange (crowding massimo)
FS_SMA_H=48                            # Richiede prezzo < SMA 48h oraria
FS_ATR_PERIOD=14
FS_SL_ATR_MULT=2.0                     # Stop Loss = 2 x ATR(1h)
FS_TP_RR=2.0                           # Take Profit = 2R (0 = solo time exit)
FS_MAX_HOLD_HOURS=24                   # Time exit: 24h
FS_COOLDOWN_HOURS=8                    # Max 1 trade per finestra funding
FS_MACRO_SMA_DAYS=200                  # Gate: daily close < SMA200
FS_SLOPE_DAYS=30                       # Gate: SMA200 piu' bassa di 30 giorni fa
FS_ENTRY_WINDOW_MIN=60                 # Ingresso entro N min dal settlement


# ==============================================================================
# SEZIONE 6B — STRATEGIA ATTIVA: MACRO CORE (regime-following giornaliero)
#
# Esposizione long "core" finche' il macro trend e' rialzista:
#   Entry: daily close > SMA200 giorni
#   Exit : chandelier — daily close < (max close dall'ingresso - 5 x ATR20d)
# Il chandelier esce dal blow-off top ~5 ATR sotto il picco, molto prima
# dell'incrocio SMA200 che costava -17% alla versione naive.
# Backtest 4y codice reale: +315% vs +136% buy&hold, maxDD 24.7%, 9 trade,
# 2023 +108% / 2024 +100% / 2025 -1%. Plateau robusto k in [4.5, 6].
# Posizione multi-mese: stato persistente su file, riconciliato col venue
# al riavvio. In macro bear resta flat e si riattiva da sola.
# ==============================================================================
MC_SYMBOL=BTCUSDT
MC_INSTRUMENT=BTC-PERPETUAL
MC_SMA_DAYS=200                        # Filtro macro: SMA 200 giorni
MC_ATR_DAYS=20                         # Periodo ATR giornaliero per il chandelier
MC_CHANDELIER_K=5.0                    # Exit: close < max_close - k * ATR20d
MC_DISASTER_SL_PCT=0.25                # Stop disastro sul venue a -25%
MC_EXPOSURE_FRACTION=1.0               # Size core = equity x frazione
MC_VOL_TARGET=0.30                     # Vol-target annualizzato (C4 equity sim:
                                       # maxDD portafoglio 29.6% -> 21.5%,
                                       # peggior anno -> 0%). 0 = disattivo
MC_VOL_LOOKBACK_DAYS=30                # Finestra vol realizzata (daily)
MC_EXPO_STEP=0.25                      # Quantizzazione esposizione (churn minimo)
MC_STATE_PATH=data/macro_core_state.json


# ==============================================================================
# ==============================================================================
#   STRATEGIE FALLIMENTARI (sezioni 7-10) — DISABILITATE
#
#   Validazione multi-ciclo 4 anni: edge lordo ~ZERO per tutte e quattro.
#   Perdita media ~20 bps/trade = esattamente i costi di transazione, in
#   OGNI fase (bull e bear), OGNI anno (2022-2026), con OGNI combinazione
#   di parametri della griglia. Non e' un problema di tuning: i concetti
#   intraday a queste frequenze non hanno edge con fee taker.
#   I parametri restano solo come riferimento storico/sperimentale.
# ==============================================================================
# ==============================================================================

# ==============================================================================
# SEZIONE 7 — FALLIMENTARE: VOLUME BREAKOUT
# Breakout intraday a 20 barre con spike di volume. Testati 9.777 trade su
# 4 anni: PF 0.42-0.74, -13/-20 bps/trade ovunque, con o senza filtro trend.
# Il breakout di breve periodo su BTC non esiste come edge (VR < 1 a tutti
# gli orizzonti). L'alternativa che funziona e' TrendBreakdown (lookback 48h+).
# ==============================================================================
VB_SYMBOL=BTCUSDT
VB_INSTRUMENT=BTC-PERPETUAL
VB_VOL_ZSCORE_THRESHOLD=2.5            # Spike volume: > N sigma dalla media rolling
VB_IMBALANCE_THRESHOLD=0.55            # OBI minimo per long (short: < 1 - soglia)
VB_BREAKOUT_LOOKBACK=20                # N candle per high/low di breakout
VB_RR_RATIO=2.5                        # Take Profit = 2.5 x rischio
VB_SL_ATR_MULT=1.5                     # Stop Loss = 1.5 x ATR(14)

# ==============================================================================
# SEZIONE 8 — FALLIMENTARE: MEAN REVERSION (VWAP FADE)
# Fade del prezzo oltre ±2σ dal VWAP rolling. Su 4 anni: PF 0.28-0.53,
# -22/-47 bps/trade, negativa in ogni regime e ogni anno, anche con gating
# trend. Le estensioni dal VWAP su BTC continuano piu' spesso di quanto
# ritraccino, e il fade non paga mai i costi.
# ==============================================================================
MR_SYMBOL=BTCUSDT
MR_INSTRUMENT=BTC-PERPETUAL
MR_VWAP_Z_THRESHOLD=2.0                # Entry quando |VWAP Z-score| > soglia
MR_MAX_VOL_ZSCORE=1.5                  # Blocca se volume spike
MR_RR_RATIO=1.5                        # Take Profit target
MR_SL_ATR_MULT=1.2                     # Stop Loss = 1.2 x ATR

# ==============================================================================
# SEZIONE 9 — FALLIMENTARE: LIQUIDATION SQUEEZE
# Cavalca le cascate di liquidazioni (proxy: volume direzionale estremo).
# Su 4 anni: PF 0.06-0.30, -21 bps/trade. Quando la cascata e' visibile
# il movimento e' gia' finito: si entra sempre sul massimo/minimo locale.
# ==============================================================================
LIQ_SYMBOL=BTCUSDT
LIQ_INSTRUMENT=BTC-PERPETUAL
LIQ_VOLUME_THRESHOLD=50.0              # BTC liquidati in 10 min per trigger
LIQ_DELTA_THRESHOLD=0.3                # CVD minimo di conferma
LIQ_RR_RATIO=1.5                       # R/R target
LIQ_SL_ATR_MULT=0.8                    # SL stretto

# ==============================================================================
# SEZIONE 10 — FALLIMENTARE: IMBALANCE SCALP
# Scalp di continuation su squilibri di flow (buy_ratio estremo).
# Su 4 anni: PF 0.18-0.50, -20 bps/trade su 29.000+ trade. Il TP 0.5% /
# SL 0.3% e' strutturalmente fee-bound: con 0.20% di costi roundtrip serve
# un edge lordo enorme che il segnale (edge ~zero) non ha. Nemmeno
# TP 1.2%/SL 0.6% lo salva.
# ==============================================================================
IS_SYMBOL=BTCUSDT
IS_INSTRUMENT=BTC-PERPETUAL
IS_IMB_THRESHOLD_LONG=0.65             # OBI > 0.65 per long
IS_IMB_THRESHOLD_SHORT=0.35            # OBI < 0.35 per short
IS_AGGR_THRESHOLD=0.60                 # Aggression ratio minimo
IS_TP_PCT=0.005                        # Take Profit +0.5%
IS_SL_PCT=0.003                        # Stop Loss -0.3%
IS_MAX_VOL_ZSCORE=1.8                  # Blocca in spike di volume

# ==============================================================================
# ==============================================================================
#   STRATEGIE LEGACY (sezioni 11-14) — mai validate quantitativamente
#   Non usano l'orderflow engine. Disabilitate di default.
# ==============================================================================
# ==============================================================================

# ==============================================================================
# SEZIONE 11 — LEGACY: IRON CONDOR (opzioni)
# Strategia neutral su opzioni Deribit.
# Abilitare con: STRATEGY_IRON_CONDOR_ENABLED=true
# ==============================================================================
TP_RATIO=0.55                          # Chiudi a 55% del credito incassato
SL_MULT=1.2                            # Stop loss a 1.2x il credito
MIN_DTE=7                              # Minimo giorni a scadenza per entrare
MAX_DTE=10                             # Massimo giorni a scadenza
MIN_IV_PERCENTILE=30                   # Minimo IV percentile
CLOSE_BEFORE_EXPIRY_HOURS=24           # Chiudi 24h prima della scadenza
RISK_PER_CONDOR=0.01                   # Rischio per condor: 1% equity
SHORT_DELTA_TARGET=0.12                # Delta target per le opzioni short (OTM)
WING_WIDTH_PERCENT=0.05                # Larghezza ali protettive: 5% del prezzo

# ==============================================================================
# SEZIONE 12 — LEGACY: SMART MONEY CONCEPT
# Analisi whale + finestra temporale EU/US.
# Abilitare con: STRATEGY_SMART_MONEY_ENABLED=true
# ==============================================================================
SM_TIME_WINDOW_START=14                # Inizio finestra operativa (ora, 24h)
SM_TIME_WINDOW_END=17                  # Fine finestra operativa
SM_WHALE_MIN_VALUE=500000              # Soglia ordine whale in USD
SM_BINANCE_SYMBOL=BTC/USDT             # Simbolo per analisi CCXT
SM_ABSORPTION_MIN_VOL=10.0             # Volume minimo per assorbimento (BTC)
SM_ABSORPTION_DELTA_RATIO=0.15         # Delta ratio soglia (15% del volume)
SM_ABSORPTION_PRICE_THRESHOLD=0.01     # Max variazione prezzo per conferma (1%)
RISK_REWARD_RATIO=2.5                  # R/R target
LEVERAGE_MAX=5                         # Leva massima

# ==============================================================================
# SEZIONE 13 — LEGACY: W/M FORMATION
# Pattern tecnico W (doppio minimo) e M (doppio massimo) multi-timeframe.
# Abilitare con: WM_ENABLED=true
# ==============================================================================
WM_DERIBIT_SYMBOL=BTC-PERPETUAL
WM_BINANCE_SYMBOL=BTC/USDT

# Timeframe
WM_PRIMARY_TIMEFRAME=15m               # Timeframe principale per il pattern
WM_CONFIRMATION_TF1=5m                 # Primo timeframe di conferma
WM_CONFIRMATION_TF2=1m                 # Secondo timeframe (timing entry)
WM_TREND_FILTER_ENABLED=false          # Filtro trend (EMA su 4h)
WM_TREND_FILTER_TF=4h

# EMA settings
WM_EMA_FAST=50
WM_EMA_MEDIUM=60
WM_EMA_SLOW=200
WM_EMA_VERY_SLOW=223

# Parametri rilevamento pattern
WM_PHASE1_MIN_VECTORS=2                # Candle vettore minime per Fase 1
WM_RETRACEMENT_MIN=0.15                # Ritracciamento minimo (15%)
WM_RETRACEMENT_MAX=0.85                # Ritracciamento massimo (85%)
WM_SWEEP_BUFFER=0.003                  # Tolleranza sweep (0.3%)
WM_ENTRY_MODE=reclaim                  # reclaim | breakout

# Risk
WM_RISK_PER_TRADE_PCT=0.02             # Rischio per trade: 2%
WM_TAKE_PROFIT_RATIO=2.0               # R/R target
WM_STOP_LOSS_BUFFER_PCT=0.005          # Buffer SL oltre il sweep (0.5%)
WM_MIN_SL_DIST=0.002                   # Distanza minima SL (0.2%)

# Logging posizioni
WM_LOG_POSITIONS=true
WM_POSITION_LOG_FILE=logs/wm_positions.txt
WM_SCAN_INTERVAL=60                    # Secondi tra ogni scan

# ==============================================================================
# SEZIONE 14 — LEGACY: NY BRINGS (sessione NY)
# Analisi vettori nella finestra 15:00-16:00 CET (apertura NY).
# Abilitare con: BRINGS_ENABLED=true
# ==============================================================================
BRINGS_DERIBIT_SYMBOL=BTC-PERPETUAL
BRINGS_BINANCE_SYMBOL=BTC/USDT
BRINGS_TIMEFRAME=5m                    # Timeframe analisi vettori
BRINGS_RISK_PER_TRADE_PCT=0.01         # Rischio per trade: 1%
BRINGS_STOP_LOSS_BUFFER=0.002          # Buffer SL (0.2%)
BRINGS_TAKE_PROFIT_RATIO=1.5           # R/R target
BRINGS_TIMEZONE=Europe/Rome            # Timezone per finestra oraria
