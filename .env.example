# Deribit API Configuration
DERIBIT_API_KEY=your_api_key_here
DERIBIT_API_SECRET=your_api_secret_here
DERIBIT_ENV=test  # test or prod

# Trading Configuration
INITIAL_EQUITY=10000
RISK_PER_CONDOR=0.01  # 1% of equity
MAX_PORTFOLIO_RISK=0.03  # 3% of equity
TP_RATIO=0.55  # Take profit at 55% of credit
SL_MULT=1.2  # Stop loss at 1.2x credit
MIN_DTE=7  # Minimum days to expiration
MAX_DTE=10  # Maximum days to expiration
MIN_IV_PERCENTILE=30  # Minimum IV rank to enter
CLOSE_BEFORE_EXPIRY_HOURS=24  # Close positions 24h before expiry

# Iron Condor Parameters
SHORT_DELTA_TARGET=0.12  # Target delta for short options
WING_WIDTH_PERCENT=0.05  # 5% width for protective wings

# Logging
LOG_LEVEL=DEBUG  # DEBUG for detailed logs, INFO for production

# Strategy Enablement
STRATEGY_IRON_CONDOR_ENABLED=true
STRATEGY_SMART_MONEY_ENABLED=true

# Smart Money Strategy Configuration
SM_TIME_WINDOW_START=14  # Start hour (14:00 = 2 PM)
SM_TIME_WINDOW_END=17    # End hour (17:00 = 5 PM)
SM_WHALE_MIN_VALUE=500000  # Minimum whale trade value in USD
SM_BINANCE_SYMBOL=BTC/USDT  # Symbol for order flow analysis
SM_ABSORPTION_MIN_VOL=10.0  # Minimum volume threshold for absorption detection
SM_ABSORPTION_DELTA_RATIO=0.15  # Delta ratio threshold (15% of total volume)
SM_ABSORPTION_PRICE_THRESHOLD=0.01  # Price change threshold (1%)

# Smart Money Risk Parameters
RISK_PER_TRADE_PCT=0.015  # 1.5% risk per trade
RISK_REWARD_RATIO=2.5  # Target 2.5:1 risk/reward
LEVERAGE_MAX=5  # Maximum leverage for futures trades

# Monitoring
MONITORING_INTERVAL_MINUTES=5  # How often to scan for new setups

# W/M Formation Strategy Configuration
WM_ENABLED=true  # Enable W/M Formation strategy
WM_DERIBIT_SYMBOL=BTC-PERPETUAL  # Deribit instrument to trade
WM_BINANCE_SYMBOL=BTC/USDT  # Binance symbol for PVSRA volume data

# W/M Timeframes
WM_PRIMARY_TIMEFRAME=15m  # Primary timeframe for formation detection
WM_CONFIRMATION_TF1=5m  # First confirmation timeframe
WM_CONFIRMATION_TF2=1m  # Second confirmation timeframe (entry timing)

# W/M Formation Detection Parameters
WM_PHASE1_MIN_VECTORS=2  # Minimum vector candles for Phase 1 (dump/pump)
WM_RETRACEMENT_MIN=0.15  # Minimum retracement percentage (15%)
WM_RETRACEMENT_MAX=0.85  # Maximum retracement percentage (85%)
WM_SWEEP_BUFFER=0.003  # Sweep tolerance (0.3%)
WM_ENTRY_MODE=reclaim # 'reclaim' or 'breakout'
WM_TREND_FILTER_ENABLED=true
WM_TREND_FILTER_TF=4h # Uses 800 EMA on 15m as proxy

# W/M EMA Settings
WM_EMA_FAST=50  # Fast EMA (primary support/resistance)
WM_EMA_MEDIUM=60  # Medium EMA
WM_EMA_SLOW=200  # Slow EMA
WM_EMA_VERY_SLOW=223  # Very slow EMA

# W/M Risk Management
WM_STOP_LOSS_BUFFER_PCT=0.005  # Stop loss buffer beyond sweep (0.5%)
WM_RISK_PER_TRADE_PCT=0.02  # Risk per trade (2% of equity)
WM_TAKE_PROFIT_RATIO=2.0  # Take profit ratio (2:1 RR)
WM_MIN_SL_DIST=0.002 # Min Stop Loss distance

# W/M Logging
WM_LOG_POSITIONS=true  # Log all W/M positions to file
WM_POSITION_LOG_FILE=logs/wm_positions.txt  # Position log file path
WM_SCAN_INTERVAL=60  # Scan interval in seconds

# ==========================================
# NY Brings Strategy Configuration
# ==========================================
BRINGS_ENABLED=true
BRINGS_DERIBIT_SYMBOL=BTC-PERPETUAL
BRINGS_BINANCE_SYMBOL=BTC/USDT
BRINGS_TIMEFRAME=5m  # Timeframe to analyze vector candles within the 15-16h window
BRINGS_RISK_PER_TRADE_PCT=0.01
BRINGS_STOP_LOSS_BUFFER=0.002
BRINGS_TAKE_PROFIT_RATIO=1.5
BRINGS_TIMEZONE=Europe/Rome
